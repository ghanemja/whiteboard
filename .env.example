# Copy to .env.local (git-ignored). Read by the dev server only, never sent to the browser.
# Set one provider below, then restart `npm run dev`. With none set, the scripted demo plays.
# README, "Models and providers", has the details.

# --- Anthropic API (default) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Local models with Ollama (v0.14+), unofficial: tool use varies by model ---
# Run: ollama pull qwen3-coder && OLLAMA_CONTEXT_LENGTH=64000 ollama serve
# ANTHROPIC_BASE_URL=http://localhost:11434
# ANTHROPIC_AUTH_TOKEN=ollama
# ANTHROPIC_MODEL=qwen3-coder
# ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3-coder
# ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3-coder
# ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3-coder

# --- Any other provider through an LLM gateway (LiteLLM, Portkey, OpenRouter…), unofficial for non-Claude models ---
# ANTHROPIC_BASE_URL=http://localhost:4000
# ANTHROPIC_AUTH_TOKEN=sk-your-gateway-key
# ANTHROPIC_MODEL=a-model-name-from-the-gateway

# --- Claude on a cloud provider ---
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_PROFILE=default
#
# CLAUDE_CODE_USE_VERTEX=1
# CLOUD_ML_REGION=global
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project
#
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=your-azure-resource
# ANTHROPIC_FOUNDRY_API_KEY=

# --- Optional ---
# AGENT_EFFORT=low
# AGENT_REPO=/path/to/a/repo
